rules_version = '2';
// CMS — Firestore security rules. Layout: casinos/{casinoId}/{collection}/{id}
// Roles live in casinos/{casinoId}/users/{uid}.role and are written only by the
// setUserRole Cloud Function (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /casinos/{cid} {
      function profile() { return get(/databases/$(database)/documents/casinos/$(cid)/users/$(request.auth.uid)).data; }
      function member() { return request.auth != null && exists(/databases/$(database)/documents/casinos/$(cid)/users/$(request.auth.uid)); }
      function role() { return profile().role; }
      function hasRole(list) { return member() && role() in list; }

      match /users/{uid} { allow read: if member(); allow write: if false; }
      match /settings/{id} { allow read: if member(); allow write: if hasRole(['admin']); }
      match /players/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','pit_supervisor','cage_cashier','credit_executive','marketing']); }
      match /ratings/{id} {
        allow read: if member();
        allow create: if hasRole(['admin','casino_manager','pit_supervisor','marketing']);
        allow update, delete: if hasRole(['admin']);
      }
      match /tables/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','pit_supervisor']); }
      match /table_shifts/{id} { allow read: if member(); allow create: if hasRole(['admin','casino_manager','pit_supervisor']); allow update, delete: if hasRole(['admin']); }
      match /hits/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','pit_supervisor']); }
      match /credit_applications/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','credit_executive','cage_cashier','marketing']); }
      match /markers/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','pit_supervisor','cage_cashier','credit_executive']); }
      match /cash_transactions/{id} {
        allow read: if member();
        allow create: if hasRole(['admin','pit_supervisor','cage_cashier','compliance_officer']);
        allow update, delete: if false; // append-only audit trail
      }
      match /ctr_reports/{id} { allow read: if member(); allow write: if hasRole(['admin','compliance_officer','casino_manager','pit_supervisor','cage_cashier']); }
      match /barred_patrons/{id} { allow read: if member(); allow write: if hasRole(['admin','compliance_officer','pit_supervisor','cage_cashier']); }
      match /sar_cases/{id} { allow read: if hasRole(['admin','compliance_officer','casino_manager','auditor']); allow write: if hasRole(['admin','compliance_officer']); }
    }
  }
}
