rules_version = '2';
// CMS — Firestore security rules. Layout: casinos/{casinoId}/{collection}/{id}
// Roles live in casinos/{casinoId}/users/{uid}.role and are written only by the
// setUserRole Cloud Function (Admin SDK bypasses these rules). Credit signatures and
// decisions, every marker money movement and CTR sign-offs are likewise written only
// by Cloud Functions (functions/src/index.js); the client may create drafts and edit
// the few fields listed below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /casinos/{cid} {
      function profile() { return get(/databases/$(database)/documents/casinos/$(cid)/users/$(request.auth.uid)).data; }
      function member() { return request.auth != null && exists(/databases/$(database)/documents/casinos/$(cid)/users/$(request.auth.uid)); }
      function role() { return profile().role; }
      function hasRole(list) { return member() && role() in list; }

      match /users/{uid} { allow read: if member() || (request.auth != null && request.auth.uid == uid); allow write: if false; }
      // Self-registration: a new account may file (or refresh) its own request, nothing else.
      // Roles are still only assigned by setUserRole, which also deletes the request.
      match /access_requests/{uid} {
        allow read: if hasRole(['admin']) || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['id','uid','name','email','requestedAt'])
          && request.resource.data.id == uid && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() > 1
          && request.resource.data.name.size() <= 120;
        allow delete: if hasRole(['admin']);
      }
      match /settings/{id} { allow read: if member(); allow write: if hasRole(['admin']); }
      match /players/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','pit_supervisor','cage_cashier','credit_executive','marketing']); }
      match /ratings/{id} {
        allow read: if member();
        allow create: if hasRole(['admin','casino_manager','pit_supervisor','marketing']);
        allow update, delete: if hasRole(['admin']);
      }
      match /tables/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','pit_supervisor']); }
      match /table_shifts/{id} { allow read: if member(); allow create: if hasRole(['admin','casino_manager','pit_supervisor']); allow update, delete: if hasRole(['admin']); }
      match /hits/{id} { allow read: if member(); allow write: if hasRole(['admin','casino_manager','pit_supervisor']); }
      match /credit_applications/{id} {
        allow read: if member();
        allow create: if hasRole(['admin','casino_manager','credit_executive','cage_cashier','marketing'])
          && request.resource.data.status == 'draft' && request.resource.data.signatures.size() == 0;
        // Fig 6.4 assessment and submission, while still a draft.
        allow update: if hasRole(['admin','casino_manager','credit_executive'])
          && resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','outcome','referrals','status'])
          && (request.resource.data.status == 'draft'
              || (request.resource.data.status == 'pending_approval' && !(resource.data.outcome in ['doNotIssue','incomplete',''])));
        allow delete: if false;
      }
      match /markers/{id} {
        allow read: if member();
        allow create, delete: if false; // issueMarker
        allow update: if hasRole(['admin','casino_manager','pit_supervisor','cage_cashier','credit_executive'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collectionNote']);
      }
      match /cash_transactions/{id} {
        allow read: if member();
        allow create: if hasRole(['admin','pit_supervisor','cage_cashier','compliance_officer']);
        allow update, delete: if false; // append-only audit trail
      }
      match /ctr_reports/{id} {
        allow read: if member();
        allow create: if hasRole(['admin','compliance_officer','casino_manager','pit_supervisor','cage_cashier'])
          && request.resource.data.status == 'draft';
        allow update: if hasRole(['admin','compliance_officer','casino_manager','pit_supervisor','cage_cashier'])
          && resource.data.status == 'draft'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fields']);
        allow delete: if false; // prepared / reviewed / filed: advanceCtr
      }
      match /barred_patrons/{id} { allow read: if member(); allow write: if hasRole(['admin','compliance_officer','pit_supervisor','cage_cashier']); }
      match /sar_cases/{id} { allow read: if hasRole(['admin','compliance_officer','casino_manager','auditor']); allow write: if hasRole(['admin','compliance_officer']); }
    }
  }
}
