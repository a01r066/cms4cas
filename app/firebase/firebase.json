{
  "firestore": { "rules": "firestore.rules" },
  "functions": [{ "source": "functions", "runtime": "nodejs24", "ignore": ["node_modules", "scripts", "test", ".git", "*.log"] }],
  "hosting": { "public": "../build/web", "ignore": ["firebase.json", "**/.*"], "rewrites": [{ "source": "**", "destination": "/index.html" }] },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  }
}
